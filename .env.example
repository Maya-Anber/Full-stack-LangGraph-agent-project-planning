# ---------------------------------------------------------------------------
# LLM provider (choose gemini or groq)
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq alternative: https://console.groq.com/keys
# Set LLM_PROVIDER=groq and fill these values instead.
GROQ_API_KEY=
# Groq retires model names regularly; check https://console.groq.com/docs/models
# if a request fails with "model does not exist or you do not have access to it".
GROQ_MODEL=openai/gpt-oss-120b

# Local RAG embeddings. The MiniLM model is downloaded once from Hugging Face.
RAG_EMBEDDING_BACKEND=minilm
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Meta Messenger webhook (optional bonus integration)
# ---------------------------------------------------------------------------
# Only needed for /webhook. FB_VERIFY_TOKEN is a string you invent and paste
# into the Meta app's webhook configuration; FB_PAGE_ACCESS_TOKEN comes from
# your Meta app's Messenger settings.
FB_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=